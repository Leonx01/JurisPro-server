# Database settings (Docker Compose default)
DATABASE_USER=root
DATABASE_PASSWORD=root123456
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=jurisprov3

# Redis settings (Docker Compose default)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Mail settings
MAIL_USERNAME=your_email@163.com
MAIL_PASSWORD=your_mail_password
MAIL_FROM=your_email@163.com
MAIL_PORT=465
MAIL_SERVER=smtp.163.com
MAIL_SSL_TLS=True
MAIL_STARTTLS=False
MAIL_TEMPLATE_PATH=resource/templates
MAIL_FROM_NAME=JurisPro

# Elastic search settings (Docker Compose default)
ELASTIC_HOSTS=https://localhost:9200
ELASTIC_USER=elastic
ELASTIC_PASSWORD=elastic123456
ELASTIC_CA_CERTS=data/http_ca.crt

# JWT settings
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_EXPIRES_IN=86400

# Application settings
APP_TITLE=JurisPro
APP_DEBUG=False
APP_PORT=8000
APP_HOST=localhost

# Sentence Transformer model path
SENTENCE_TRANSFORMER_MODEL=./src/data/bge-small-zh-v1.5-ft
