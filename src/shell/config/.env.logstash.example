# Logstash 环境变量配置示例
# 启动 Logstash 时使用: logstash -f config.conf --env-config-path .env.logstash

# JDBC 驱动路径
JDBC_DRIVER_PATH=D:/logstash-8.17.1/driver/mysql-connector-j-8.0.33.jar

# MySQL 连接配置
JDBC_CONNECTION_STRING=jdbc:mysql://localhost:3306/jurisprov3?serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
JDBC_USER=root
JDBC_PASSWORD=your_mysql_password

# Elasticsearch 连接配置
ES_HOSTS=https://localhost:9200
ES_USER=elastic
ES_PASSWORD=your_es_password
ES_CA_CERT_PATH=D:/logstash-8.17.1/http_ca.crt
